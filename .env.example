OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Modelo oficial con timestamps (gpt-transcribe no los admite según la doc actual). Se usa solo como fallback automático.
OPENAI_TIMESTAMP_MODEL=whisper-1
OPENAI_IMAGE_MODEL=gpt-image-2
# 16:9 exacto, lados múltiplos de 16. Se reduce a 1920x1080 en FFmpeg sin deformar.
OPENAI_IMAGE_SIZE=2048x1152
OPENAI_IMAGE_QUALITY=medium
FFMPEG_PATH=
PORT=3000
